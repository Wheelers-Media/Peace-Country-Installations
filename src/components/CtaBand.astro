---
interface Props { label: string }
const { label } = Astro.props;
---
<section class="cta">
  <div class="wrap cta-inner">
    <div>
      <h2>Ready to Get Connected?</h2>
      <p>Serving Grande Prairie and surrounding communities throughout Northern Alberta. Contact us today to discuss your specific connectivity needs.</p>
    </div>
    <div class="btns">
      <a class="btn btn-primary" href="/#quote">{label}</a>
      <a class="btn btn-ghost" href="tel:5874160303">587-416-0303</a>
    </div>
  </div>
</section>

<style>
  .cta { background: var(--night); color: #f1f5f9; padding-block: clamp(48px, 7vw, 80px); }
  .cta-inner { display: grid; gap: 28px; align-items: center; grid-template-columns: 1fr; }
  @media (min-width: 900px) { .cta-inner { grid-template-columns: 1.4fr auto; gap: 56px; } }
  p { color: #c5cfdb; max-width: 60ch; margin: 0; }
</style>
