---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  name: string;
  stock: string;
  category: string;
  price?: string;
  description?: string;
  features: string[];
  id: string;
  variants: { key: string; label: string; cents: number }[] | null;
}
const { image, alt, name, stock, category, price, description, features, id, variants } = Astro.props;

// Products whose variants cost different amounts show "From $X" until a variant is chosen.
const dollars = (cents: number) => `$${(cents / 100).toFixed(2)}`;
const differs = variants ? new Set(variants.map((v) => v.cents)).size > 1 : false;
const shownPrice = differs && variants ? `From ${dollars(Math.min(...variants.map((v) => v.cents)))}` : price;
---
<article class="product">
  <div class="media">
    <Image src={image} alt={alt} widths={[320, 480, 720]} sizes="(min-width: 1024px) 360px, (min-width: 640px) 45vw, 92vw" />
  </div>
  <div class="body">
    <p class="meta"><span class="stock">{stock}</span><span>{category}</span></p>
    <h3>{name}</h3>
    {shownPrice && <p class="price">{shownPrice} <abbr title="Canadian dollars">CAD</abbr></p>}
    {description && <p class="desc">{description}</p>}
    <ul class="ticks">{features.map((f) => <li>{f}</li>)}</ul>
    {variants && (
      <label class="variant">
        <span>Length</span>
        <select class="variant-select" data-for={id}>
          {variants.map((v) => <option value={v.key}>{differs ? `${v.label} - ${dollars(v.cents)}` : v.label}</option>)}
        </select>
      </label>
    )}
    <button type="button" class="btn btn-primary btn-block add-to-cart" data-id={id}>
      Add to Cart<span class="visually-hidden">: {name}</span>
    </button>
  </div>
</article>

<script>
  // One delegated listener for every card; the cart drawer listens for 'cart:add'.
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.add-to-cart');
    if (!btn) return;
    const select = btn.closest('.product')?.querySelector<HTMLSelectElement>('.variant-select');
    window.dispatchEvent(new CustomEvent('cart:add', { detail: { id: btn.dataset.id, variant: select?.value ?? null } }));
  });
</script>

<style>
  .product { display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r); overflow: hidden; transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease); }
  .product:hover { transform: translateY(-3px); box-shadow: 0 18px 40px rgb(15 27 45 / 0.12); }
  .media { background: #fff; aspect-ratio: 4 / 3; display: grid; place-items: center; padding: 20px; }
  .media img { width: 100%; height: 100%; object-fit: contain; }
  .body { display: flex; flex-direction: column; gap: 4px; padding: 22px; flex: 1; }
  .meta { display: flex; flex-wrap: wrap; gap: 6px 12px; font-size: 0.78rem; color: var(--muted); margin-bottom: 6px; }
  .stock { color: var(--accent-ink); font-weight: 700; }
  h3 { font-size: 1.1rem; margin-bottom: 4px; }
  .price { font: 800 1.35rem/1.2 var(--font-head); margin-bottom: 6px; font-variant-numeric: tabular-nums; }
  .price abbr { font-size: 0.75rem; color: var(--muted); text-decoration: none; letter-spacing: 0.06em; }
  .desc { color: var(--muted); font-size: 0.95rem; }
  .ticks { font-size: 0.92rem; margin-bottom: 20px; }
  .btn { margin-top: auto; }
  .variant { display: grid; gap: 6px; margin-bottom: 14px; font-size: 0.85rem; font-weight: 600; }
  .variant select { padding: 10px 12px; border: 1px solid var(--line); border-radius: var(--r-sm); background: var(--surface); color: var(--ink); font: inherit; font-weight: 500; }
  @media (prefers-reduced-motion: reduce) { .product, .product:hover { transition: none; transform: none; } }
</style>
